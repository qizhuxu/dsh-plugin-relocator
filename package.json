{
  "name": "dsh-plugin-relocator",
  "version": "0.3.0",
  "description": "把 DSH 插件安装到用户指定目录，并为每个插件维护独立目录与独立依赖：迁出 / 恢复 / 体检 / 回滚。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    },
    "manifestVersion": 1
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5",
    "@deepseek-ai/schemastery": ">=3.18.4 <4",
    "react": ">=18.2.0 <19"
  },
  "scripts": {
    "self-test": "node test/self-test.mjs",
    "install-into-dsh": "node scripts/install.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qizhuxu/dsh-plugin-relocator.git"
  },
  "homepage": "https://github.com/qizhuxu/dsh-plugin-relocator#readme",
  "bugs": {
    "url": "https://github.com/qizhuxu/dsh-plugin-relocator/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "relocator",
    "disk",
    "pnpm"
  ]
}
